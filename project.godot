; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but editing by hand is also supported.
; Format: https://docs.godotengine.org/en/stable/classes/class_configfile.html

config_version=5

[application]

config/name="City Chaos"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://scripts/autoloads/input_setup.gd"
SaveData="*res://scripts/autoloads/save_data.gd"
WantedSystem="*res://scripts/autoloads/wanted_system.gd"
NetworkManager="*res://scripts/autoloads/network_manager.gd"
GameManager="*res://scripts/autoloads/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"

[physics]

common/enable_pause_aware_picking=true
3d/default_gravity=20.0
3d/physics_engine="DEFAULT"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.18, 0.22, 0.28, 1)
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=1
rendering/gl_compatibility/driver="opengl3"
rendering/gl_compatibility/driver.windows="opengl3"
